# Chiave API di Anthropic per l'assistente del sito (console.anthropic.com).
# Senza chiave l'assistente funziona in modalità guidata, senza AI.
ANTHROPIC_API_KEY=

# Modello usato dall'assistente
CHAT_MODEL=claude-haiku-5-5

# Link di prenotazione Cal.com (es. https://cal.com/nodo-studio/assessment)
NEXT_PUBLIC_BOOKING_URL=

# Webhook n8n che riceve i lead raccolti dall'assistente (facoltativo)
LEAD_WEBHOOK_URL=

# Contatti nel footer
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_VAT=
